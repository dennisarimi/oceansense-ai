# =============================================================================
# OceanSense AI — Backend
#
# Two stages: "dev" and "prod"
# Selected via: ENV=dev docker compose up --build
# =============================================================================

# -----------------------------------------------------------------------------
# Base — shared setup between dev and prod
# -----------------------------------------------------------------------------
FROM python:3.12-slim-bookworm AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install PyTorch CPU first — cached separately so dep changes don't re-download it
RUN pip install --no-cache-dir \
    torch \
    --index-url https://download.pytorch.org/whl/cpu

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# -----------------------------------------------------------------------------
# Development stage
# Source code is synced live by docker compose watch.
# uvicorn runs with --reload so code changes restart the server automatically.
# -----------------------------------------------------------------------------
FROM base AS dev

COPY app/ ./app/
COPY .env* ./

EXPOSE 8000

CMD ["uvicorn", "app.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--reload", \
     "--reload-dir", "/app/app"]

# -----------------------------------------------------------------------------
# Production stage
# Source is baked into the image. No reload, no dev tooling.
# -----------------------------------------------------------------------------
FROM base AS prod

COPY app/ ./app/
COPY .env* ./

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]