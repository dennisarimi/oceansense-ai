# =============================================================================
# OceanSense AI — Backend
# Uses prebuilt PyTorch 2.4.1 CPU wheels from pytorch.org.
# Works on x86_64 (Intel/AMD) and ARM64 (Apple Silicon, AWS Graviton).
# No compilation required — builds in ~5 minutes.
# =============================================================================

FROM python:3.12-slim-bookworm

# Runtime system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install PyTorch CPU-only explicitly before the rest of requirements.
# Pinned to 2.4.1 — the version this project was developed and tested against.
# --index-url points to the CPU-only wheel index to avoid pulling large CUDA binaries.
RUN pip install --no-cache-dir \
    torch \
    --index-url https://download.pytorch.org/whl/cpu

# Install remaining application dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
        && pip install --no-cache-dir -r requirements.txt

# Copy application source
COPY app/ ./app/
COPY .env* ./

# ---------- create writable Chroma store ----------
    # RUN mkdir -p /app/chroma_store

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
